# WGC Payments — environment variables
#
# No .env.example previously existed in this repo. This one documents every
# environment variable actually referenced in src/ and prisma/schema.prisma
# as of the System Health / monitoring Phase 1 work — never commit real
# values here, only placeholders/format hints. Copy to .env.local and fill
# in real values for local development.

# ─── Database (Supabase Postgres) ───────────────────────────────────────────
# DATABASE_URL is the pooled (pgbouncer) connection Prisma uses at runtime;
# DIRECT_URL is the unpooled connection Prisma uses for migrations.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres"
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"
SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=

# ─── App / auth ──────────────────────────────────────────────────────────────
AUTH_SESSION_SECRET=
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Shared secret every Vercel cron route (src/app/api/cron/**) requires in its
# Authorization: Bearer header. Missing in production triggers an admin email
# alert (src/lib/cron/alertCronMisconfiguration.ts) rather than failing silently.
CRON_SECRET=
# Local-only diagnostic/admin-setup helpers — never set these in production.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SETUP_SECRET=
SANDBOX_ADMIN_EMAIL=
SANDBOX_ADMIN_PASSWORD=
TEST_WEBHOOK_SECRET=

# ─── Sentry (technical error monitoring — see src/lib/monitoring/captureError.ts) ──
# Everything below is optional: unset, Sentry.init() is a documented no-op and
# the app behaves identically with zero Sentry configuration.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to enable production source-map upload at build time
# (next.config.ts's withSentryConfig) — without these, the build proceeds
# normally and just skips the upload with a warning.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─── Resend (transactional email) ───────────────────────────────────────────
RESEND_API_KEY=
# Falls back to "WGC Payments <no-reply@wgcpayments.com>" if unset.
EMAIL_FROM=
# Destination for every internal "notify WGC" email today (new support
# tickets, onboarding notifications, cron misconfiguration alerts, and — as
# of this System Health work — system alert emails). Falls back to
# support@wgcpayments.com if unset.
SUPPORT_EMAIL=

# ─── Twilio (SMS) ────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Approved for 2FA/authentication SMS ONLY (src/lib/sms/authSmsSender.ts).
TWILIO_2FA_FROM_NUMBER=
# Deliberately left unset in every environment today — donor/campaign SMS
# (src/lib/sms/sendText.ts) is hard-disabled until a separate A2P 10DLC
# campaign is approved for non-authentication content. Do not set this to
# the same value as TWILIO_2FA_FROM_NUMBER or TWILIO_FROM_NUMBER.
TWILIO_DONOR_FROM_NUMBER=
TWILIO_FROM_NUMBER=

# ─── Finix (payments processor) ─────────────────────────────────────────────
FINIX_USERNAME=
FINIX_PASSWORD=
FINIX_BASE_URL="https://finix.sandbox-payments-api.com"
FINIX_APPLICATION_ID=
FINIX_APPLICATION_OWNER_ID=
FINIX_VERSION=
FINIX_ENV=
FINIX_ENVIRONMENT=
FINIX_PROCESSOR=
NEXT_PUBLIC_FINIX_APPLICATION_ID=
NEXT_PUBLIC_FINIX_ENV="sandbox"
NEXT_PUBLIC_FINIX_DASHBOARD_LOGIN_URL=
NEXT_PUBLIC_FINIX_PRIVACY_URL=
NEXT_PUBLIC_FINIX_TERMS_URL=
NEXT_PUBLIC_FINIX_APPLE_PAY_MERCHANT_IDENTIFIER=
NEXT_PUBLIC_ENABLE_TEST_WALLET_ADAPTER=
FINIX_SUBSCRIPTIONS_SYNC_ENABLED=
FINIX_SYNC_DEBUG=
# WGC's own platform-billing Finix identity/merchant (for charging churches
# their WGC subscription, distinct from a church's own Finix merchant).
FINIX_WGC_BILLING_IDENTITY_ID=
FINIX_WGC_BILLING_MERCHANT_ID=
WGC_DONOR_COVERED_ZERO_FEE_PROFILE_ID=
WGC_ORGANIZATION_PAID_FEE_PROFILE_ID=
WGC_BILLING_GRACE_PERIOD_DAYS=
ALLOW_SETTLEMENT_BACKFILL=

# Finix inbound webhook authentication (src/app/api/webhooks/finix/route.ts)
# — configure at least one auth mechanism below, or the route hard-rejects
# every event. Several are accepted alias names for the same concept; check
# the route's normalizeSecret()/auth logic before assuming which are live.
FINIX_WEBHOOK_SECRET=
FINIX_WEBHOOK_SIGNING_KEY=
FINIX_WEBHOOK_BEARER_TOKEN=
FINIX_WEBHOOK_BASIC_USERNAME=
FINIX_WEBHOOK_BASIC_PASSWORD=
FINIX_WEBHOOK_BASIC_AUTH_USERNAME=
FINIX_WEBHOOK_BASIC_AUTH_PASSWORD=
FINIX_WEBHOOK_USERNAME=
FINIX_WEBHOOK_PASSWORD=

# Outbound merchant-facing webhook signing (developer API feature,
# src/lib/webhooks/) — distinct from FINIX_WEBHOOK_SECRET above, which is
# for inbound Finix→WGC events.
WEBHOOK_SIGNING_SECRET_ENCRYPTION_KEY=

# ─── Google / Apple Pay ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PAY_PRODUCTION_APPROVED=
NEXT_PUBLIC_GOOGLE_PAY_MERCHANT_ID=
NEXT_PUBLIC_APPLE_PAY_MERCHANT_ID=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ─── Aplos integration ───────────────────────────────────────────────────────
APLOS_API_BASE_URL="https://app.aplos.com/hermes/api/v1"
APLOS_CREDENTIAL_ENCRYPTION_KEY=
# Platform-wide kill switch for the automatic-sync cron — see
# src/lib/integrations/aplos/config.ts.
APLOS_SYNC_ENABLED=

# ─── QuickBooks integration ──────────────────────────────────────────────────
QUICKBOOKS_INTEGRATION_ENABLED=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=
QUICKBOOKS_CREDENTIAL_ENCRYPTION_KEY=
QUICKBOOKS_ENVIRONMENT="sandbox"
QUICKBOOKS_SCOPES=
QUICKBOOKS_WEBHOOK_VERIFIER_TOKEN=

# ─── Printful integration (merchandise) ─────────────────────────────────────
PRINTFUL_INTEGRATION_ENABLED=
PRINTFUL_MODE="mock"
PRINTFUL_API_BASE_URL=
PRINTFUL_CLIENT_ID=
PRINTFUL_CLIENT_SECRET=
PRINTFUL_ACCESS_TOKEN=
PRINTFUL_CREDENTIAL_ENCRYPTION_KEY=
PRINTFUL_WEBHOOK_SECRET=

# ─── reCAPTCHA (onboarding application form) ────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ─── Product analytics / marketing pixels ───────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_META_PIXEL_ID=

# ─── Payout account safety limits ───────────────────────────────────────────
PAYOUT_ACCOUNT_MAX_PENDING_CHANGE_REQUESTS=
PAYOUT_ACCOUNT_MAX_STORED_HISTORICAL_ACCOUNTS=
PAYOUT_PROOF_MAX_FILES=

# ─── Vercel-provided (do not set manually — populated automatically) ───────
# VERCEL_ENV, VERCEL_URL, VERCEL_GIT_COMMIT_SHA, NEXT_PUBLIC_VERCEL_ENV,
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA, NODE_ENV, NEXT_RUNTIME

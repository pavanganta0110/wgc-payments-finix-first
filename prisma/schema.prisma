model User {
  id                        String    @id @default(cuid())
  email                     String    @unique
  // Internal WGC admin display name (Settings -> Admins). Null for
  // merchant-side users, who don't have a separate display name field.
  name                      String?
  passwordHash              String?
  // Team-access Checkpoint 1: organization-side roles are "owner" |
  // "admin" | "fundraiser" | "viewer" (exactly one "owner" per church,
  // enforced at the application layer via Church.primaryOwnerUserId, not a
  // DB constraint). "wgc_admin" is WGC's own internal support role and is
  // never treated as an organization owner anywhere in permission logic —
  // kept as a completely separate value on purpose. Existing rows are all
  // "wgc_admin" or the legacy "church_admin" until the owner-backfill
  // migration (see ownerBackfillPreview) maps church_admin -> owner/admin.
  role                      String // "wgc_admin" | "owner" | "admin" | "fundraiser" | "viewer" (legacy: "church_admin")
  churchId                  String?
  setPasswordTokenHash      String?
  setPasswordTokenExpiresAt DateTime?
  lastLoginAt               DateTime?
  // Team & Access (Settings -> Team). A User with passwordHash null and a
  // live setPasswordTokenHash is "invited, pending" — the exact same
  // pattern already used by forgot-password, reused here rather than
  // inventing a separate invitation concept.
  invitedByUserId           String?
  disabledAt                DateTime?
  disabledByUserId          String?
  // Team-access Checkpoint 1: roles + a small override on top, per the
  // approved plan (roles are the primary model; this is for narrow
  // exceptions like an ADMIN being granted canManageBankAccount without a
  // full OWNER promotion) — never trusted alone client-side, always
  // re-read server-side by requirePermission().
  permissionsJson           Json?
  // Team-access Checkpoint 1: incremented whenever this user's role,
  // permissions, active/disabled status, or bank-management permission
  // changes (see bumpAuthVersion in src/lib/auth/session.ts). The signed
  // session cookie carries the authVersion value that was current at
  // sign-in; getSession() rejects the cookie if it no longer matches the
  // DB value, so a stale session can't keep acting on since-revoked
  // permissions until it naturally expires (previously not possible at
  // all — session.ts had no DB lookup, this app's getSession() was purely
  // stateless HMAC signature + expiry).
  authVersion               Int       @default(1)
  // Bumped on every completed password reset. Internal WGC admin session
  // tokens carry the value that was current at sign-in; getAdminSession()
  // rejects the cookie on a mismatch — the admin-panel's own invalidation
  // mechanism, independent of authVersion (which requireMerchantSession()
  // uses for the merchant dashboard).
  passwordChangedAt         DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  authAccounts              AuthAccount[]

  @@index([churchId])
}

model FinixAuthorization {
  id                       String    @id @default(cuid())

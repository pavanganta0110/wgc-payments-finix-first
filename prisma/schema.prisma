  currency                 String?
  failureCode              String?
  failureMessage           String?
  isVoid                   Boolean?
  voidState                String?
  voidedAt                 DateTime?
  expiresAt                DateTime?
  authorizationCode        String?
  traceId                  String?
  cvvVerification          String?
  addressVerification      String?
  tagsJson                 Json?
  rawJsonRedacted          Json?
  createdAtFinix           DateTime?
  updatedAtFinix           DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  lastSyncedAt             DateTime?

  @@index([churchId, createdAtFinix])
}

// A configurable, trackable donation link — distinct from the simpler
// GivingPage model below (which powers each church's one always-on default
// giving page). A GivingLink is created per-campaign, has its own lifecycle
// (active/inactive/expired/archived), amount rules, donor-field visibility,
// branding, and attempt/share tracking. Every Payment/PaymentAttempt/
// FinixSubscription created through one is tagged with its id for
// attribution (see givingLinkId fields above).
model GivingLink {
  id                        String    @id @default(cuid())
  churchId                  String
  publicSlug                String    @unique
  internalName              String
  publicTitle               String
  description               String?
  status                    String    @default("ACTIVE") // ACTIVE | INACTIVE | EXPIRED | ARCHIVED
  amountType                String    @default("FIXED") // FIXED | VARIABLE | FIXED_QUANTITY
  fixedAmountCents          Int?      // also the per-item price when amountType is FIXED_QUANTITY
  minAmountCents            Int?
  maxAmountCents            Int?
  suggestedAmountsJson      Json?
  allowCustomAmount         Boolean   @default(true)
  // FIXED_QUANTITY only: optional noun shown next to the quantity stepper
  // on the public giving page (e.g. "Backpack") — purely cosmetic, never
  // parsed. A donor on a FIXED_QUANTITY link can always add an extra
  // dollar amount on top of quantity * fixedAmountCents; that's not a
  // separate toggle, just always-on for this mode.
  quantityItemLabel         String?
  linkType                  String    @default("MULTI_USE") // ONE_TIME | MULTI_USE
  maxSuccessfulUses         Int?
  maxCollectedAmountCents   Int?
  expiresAt                 DateTime?
  // Legacy single free-text fund label — kept for backward compatibility,
  // superseded by the Fund/GivingLinkFund catalog below for links with
  // fundSelectionEnabled = true.
  fundName                  String?
  fundId                    String?
  // Gift Designations: when true, the public giving page offers a fund
  // dropdown built from this link's GivingLinkFund assignments.
  fundSelectionEnabled      Boolean   @default(false)
  recurringEnabled          Boolean   @default(false)
  allowedFrequenciesJson    Json?
  allowedPaymentMethodsJson Json? // ["CARD","BANK","APPLE_PAY","GOOGLE_PAY"]
  donorFieldSettingsJson    Json?
  // Shows the collapsed "Add mailing address (optional)" accordion on this
  // link's public giving page when true. Per-link, not organization-wide —
  // seeded from Church.defaultCollectMailingAddressOnNewLinks at creation
  // time, then independently editable per link. Never affects any other
  // giving link when changed.
  collectMailingAddress     Boolean   @default(true)
  feeCoverEnabled           Boolean   @default(true)
  feeCoverDefaultOn         Boolean   @default(true)
  receiptSettingsJson       Json?
  statementDescriptor       String?
  internalNote              String?
  referenceNumber           String?
  successReturnUrl          String?
  failureReturnUrl          String?
  cancelReturnUrl           String?
  brandingSettingsJson      Json?
  totalAttempts             Int       @default(0)
  successfulDonations       Int       @default(0)
  totalCollectedCents       Int       @default(0)
  refundedCents             Int       @default(0)
  returnedCents             Int       @default(0)
  lastUsedAt                DateTime?
  // Who created this link — never overwritten on reassignment. Preserved
  // exactly as-is; see ownerUserId below for the field the Checkpoint 3
  // attribution/reassignment work actually operates on.
  createdByUserId           String?
  // Team-access Checkpoint 3: whose fundraising activity/reporting this link
  // belongs to — distinct from createdByUserId (who made the link). An
  // owner/admin can create a link on behalf of a fundraiser, in which case
  // createdByUserId = the owner/admin and ownerUserId = the fundraiser.
  // Defaults to the acting user at creation time if not explicitly assigned;
  // a FUNDRAISER can only ever create links with ownerUserId = themselves
  // (server-enforced, never trusted from client JSON). Reassigning this
  // field changes attribution for FUTURE payments/subscriptions only —
  // Payment.attributedUserId/FinixSubscription.attributedUserId are
  // snapshotted once at creation and never rewritten when this changes. See
  // Payment.attributedUserId's comment for why this stays a plain string
  // field rather than a Prisma relation.
  ownerUserId               String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  // Printful merchandise: purely additive, defaults to false/null so every
  // existing giving link is completely unaffected. When true, the public
  // giving page renders the merchandise section built from this link's
  // GivingPageMerchandise assignments (see prisma/schema.prisma's Printful
  // section further below).
  merchandiseEnabled      Boolean @default(false)
  merchandiseSettingsJson Json?

  @@index([churchId, ownerUserId])
}

model GivingLinkShare {
  id             String    @id @default(cuid())
  givingLinkId   String
  churchId       String
  sharedByUserId String?
  channel        String // COPY_LINK | QR_CODE | EMAIL | TEXT | MANUAL | EMBED
  recipient      String?
  message        String?
  state          String    @default("SENT") // SENT | FAILED | PENDING
  openedAt       DateTime?
  createdAt      DateTime  @default(now())
}

// One immutable snapshot per (donor, taxYear, version) — a later donor-name
// or organization-address change never alters a statement already
// generated/sent. Regenerating after a donation adjustment creates a new
// version and marks the previous one superseded rather than overwriting it.
model AnnualDonationStatement {
  id       String @id @default(cuid())
  churchId String
  donorId  String
  taxYear  Int
  version  Int    @default(1)

  statementStatus String @default("NOT_GENERATED") // NOT_GENERATED | NEEDS_REVIEW | READY | GENERATED | VOIDED
  deliveryStatus  String @default("NOT_SENT") // NOT_SENT | QUEUED | SENT | DELIVERED | BOUNCED | FAILED

  grossDonatedCents      Int @default(0)
  refundedAmountCents    Int @default(0)
  returnedAmountCents    Int @default(0)
  disputeAdjustmentCents Int @default(0)
  eligibleAmountCents    Int @default(0)
  donationCount          Int @default(0)

  // Snapshots — copied at generation time, never re-read live.
  donorNameSnapshot           String?
  donorEmailSnapshot          String?
  donorAddressSnapshot        Json?
  organizationNameSnapshot    String?
  organizationAddressSnapshot Json?
  organizationTaxIdSnapshot   String?

  pdfStorageReference     String?
  secureDownloadTokenHash String?
  secureDownloadExpiresAt DateTime?

  generatedByUserId String?
  generatedAt       DateTime?

  recipientEmail         String?
  emailProviderMessageId String?
  sentAt                 DateTime?
  deliveredAt            DateTime?
  bouncedAt              DateTime?
  failureReason          String?
  resendCount            Int       @default(0)

  supersededAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([donorId, taxYear, version])
  @@index([churchId])
  @@index([donorId])
  @@index([churchId, taxYear])
}

/// Background job for bulk statement generate/send. There is no persistent
/// worker process in this app (serverless, no queue infra) — the client
/// drives progress by repeatedly calling the "process one chunk" route while
/// status is PENDING/RUNNING, and each call advances processedCount by one
/// chunk. This is a real chunked-processing job (state lives in the DB and
/// survives a page reload), not a UI-only fake progress bar.
model BulkStatementJob {
  id       String @id @default(cuid())
  churchId String
  taxYear  Int
  jobType  String // GENERATE | SEND

  targetIds  Json // donorIds for GENERATE, statementIds for SEND
  totalCount Int

  status String @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED

  processedCount   Int @default(0)
  succeededCount   Int @default(0)
  failedCount      Int @default(0)
  needsReviewCount Int @default(0)
  skippedCount     Int @default(0)

  createdByUserId String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([churchId, status])
}

/// Same chunked-job pattern as BulkStatementJob, for sending the
/// ExternalDonation rows a CSV import queued (receiptStatus: "QUEUED")
/// without blocking the import commit request or a single web request.
model BulkReceiptJob {
  id       String @id @default(cuid())
  churchId String

  targetIds  Json // ExternalDonation ids
  totalCount Int

  status String @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED

  processedCount Int @default(0)
  succeededCount Int @default(0)
  failedCount    Int @default(0)
  skippedCount   Int @default(0)

  createdByUserId String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([churchId, status])
}

model AnnualDonationStatementLine {
  id                    String  @id @default(cuid())
  annualStatementId     String
  paymentId             String?
  // Set instead of paymentId for a line sourced from a Record External
  // Donation entry (cash, check, Cash App, etc.) rather than a Finix
  // transfer — see ExternalDonation. Set instead of both for a line
  // sourced from an invoice payment (see InvoicePayment; only invoices
  // with classification CHARITABLE_DONATION/PARTIAL_DONATION and a
  // linkedDonorId ever produce one). Exactly one of paymentId/
  // externalDonationId/invoicePaymentId is set per line, never more than one.
  externalDonationId    String?
  invoicePaymentId      String?
  // Preserved alongside `reference` (which holds the Finix transfer/
  // transaction ID for an invoice-sourced line, same as every other
  // source) so the statement can reconcile back to the specific invoice
  // even after the invoice itself is edited/renumbered — this is a
  // point-in-time snapshot, not a live lookup.
  invoiceNumberSnapshot String?
  paymentMethodLabel    String?

  donationDate       DateTime?
  reference          String?
  fundOrCampaignName String?

  grossAmountCents       Int @default(0)
  donorCoveredFeeCents   Int @default(0)
  refundedAmountCents    Int @default(0)
  returnedAmountCents    Int @default(0)
  disputeAdjustmentCents Int @default(0)
  eligibleAmountCents    Int @default(0)

  // Snapshotted from the Payment's goods/services fields at generation
  // time, per line — a statement immutably reflects what each individual
  // contribution actually disclosed, not a live re-read.
  goodsServicesProvided             Boolean @default(false)
  goodsServicesDescription          String?
  goodsServicesFairMarketValueCents Int?
  recordedContributionAmountCents   Int?

  createdAt DateTime @default(now())

  @@index([annualStatementId])
}

/// A merchant-saved Donor Analytics & Reporting configuration (Reporting ->
/// Saved Reports). Stores only the report DEFINITION (date-range logic,
/// filters, columns, grouping, sorting, donation-source toggles, gross/net
/// selection) as JSON, never generated donor/financial results — results
/// are always regenerated fresh from live data when a saved report is
/// opened, so a saved report can never go stale or leak data the viewer
/// isn't currently authorized to see.
model SavedReport {
  id              String   @id @default(cuid())
  churchId        String
  createdByUserId String
  name            String
  // "DONORS" | "GIVING" | "ANNUAL" | "RECURRING" | "LAPSED" | "FUND_CAMPAIGN"
  // | "YEAR_OVER_YEAR" — see ReportType in lib/reporting/types.ts, the
  // single source of truth for valid values (validated server-side on
  // every write, never trusted as an arbitrary string from the client).
  reportType String
  // Full ReportDefinition (dateRange, filters, columns, groupBy, sortBy,
  // sources, amountCalculation) — validated against the same Zod schema
  // used by the query/export APIs before being persisted.
  configuration Json
  // PRIVATE = only createdByUserId can see/use it. ORGANIZATION = any team
  // member with canViewDonors can see/use it, but only the creator (or an
  // owner/admin, per canManageSavedReports) can rename/edit/delete it.
  visibility String @default("PRIVATE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([churchId])
  @@index([createdByUserId])
  @@index([reportType])
}

model SynchronizationState {
  id               String    @id @default(cuid())
  churchId         String
  syncType         String
  lastAttemptedAt  DateTime?
  lastSuccessfulAt DateTime?
  resultCount      Int       @default(0)
  lastErrorAt      DateTime?
  lastErrorCode    String?
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@unique([churchId, syncType])
  @@index([syncType, lastSuccessfulAt])
}


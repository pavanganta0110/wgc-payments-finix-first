generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model OnboardingApplication {
  id                                String                       @id @default(cuid())
  organizationName                  String
  organizationType                  String
  contactName                       String
  contactEmail                      String
  contactPhone                      String?
  website                           String?
  status                            String
  finixIdentityId                   String?
  finixMerchantId                   String?
  submittedAt                       DateTime?
  approvedAt                        DateTime?
  rejectedAt                        DateTime?
  updateRequestedAt                 DateTime?
  updateReason                      String?
  finixOnboardingFormId             String?
  onboardingStatus                  String?
  verificationState                 String?
  lastFinixEventId                  String?
  lastFinixEventType                String?
  lastStatusChangedAt               DateTime?
  updateRequestedReason             String?
  updateRequestedItems              String?
  updateRequestedCodes              Json?
  rejectionReasonInternal           String?
  lastWebhookPayloadSummary         Json?
  updateTokenHash                   String?
  updateTokenExpiresAt              DateTime?
  lastUpdateSubmittedAt             DateTime?
  processingEnabled                 Boolean                      @default(false)
  settlementEnabled                 Boolean                      @default(false)
  createdAt                         DateTime                     @default(now())
  updatedAt                         DateTime                     @updatedAt
  achMaxTransactionAmountCents      Int?
  annualAchVolumeCents              Int?
  annualCardVolumeCents             Int?
  averageAchTransferAmountCents     Int?
  averageCardTransferAmountCents    Int?
  bankAccountType                   String?
  bankCountry                       String?
  bankCurrency                      String?
  bankInstrumentEnabled             Boolean                      @default(false)
  bankInstrumentId                  String?
  bankLast4                         String?
  bankName                          String?
  businessAddressLine1              String?
  businessAddressLine2              String?
  businessCity                      String?
  businessCountry                   String?
  businessDescription               String?
  businessPhone                     String?
  businessPostalCode                String?
  businessState                     String?
  businessTaxIdProvided             Boolean                      @default(false)
  businessToBusinessPercentage      Int?
  businessToConsumerPercentage      Int?
  businessType                      String?
  cardPresentPercentage             Int?
  defaultStatementDescriptor        String?
  doingBusinessAs                   String?
  ecommercePercentage               Int?
  finixApplicationId                String?
  finixPaymentInstrumentId          String?
  finixProcessor                    String?
  finixVerificationId               String?
  hasAcceptedCreditCardsPreviously  Boolean                      @default(false)
  incorporationDay                  Int?
  incorporationMonth                Int?
  incorporationYear                 Int?
  legalBusinessName                 String?
  mailOrderTelephoneOrderPercentage Int?
  maxTransactionAmountCents         Int?
  mcc                               String?
  onboardingState                   String?
  otherVolumePercentage             Int?
  ownershipType                     String?
  principalAddressLine1             String?
  principalAddressLine2             String?
  principalCity                     String?
  principalCountry                  String?
  principalDobDay                   Int?
  principalDobMonth                 Int?
  principalDobYear                  Int?
  principalEmail                    String?
  principalFirstName                String?
  principalLastName                 String?
  principalOwnershipPercentage      Int?
  principalPhone                    String?
  principalPostalCode               String?
  principalState                    String?
  principalTaxIdProvided            Boolean                      @default(false)
  principalTitle                    String?
  refundPolicy                      String?
  // TODO: Confirm exact Finix termination/suspension API and webhook event with Finix.
  // Placeholder fields only — no behavior implemented yet.
  terminationStatus                 String?
  terminatedAt                      DateTime?
  terminationReason                 String?
  suspendedAt                       DateTime?
  suspensionReason                  String?
  promotion                         String?
  associatedOwners                  AssociatedOwner[]
  documents                         MerchantDocument[]
  internalDocuments                 OnboardingInternalDocument[]
}

// A WGC-only document collected during onboarding — never sent to Finix or
// any processor-related service. Deliberately a separate model from
// MerchantDocument (which always carries a finixFileId and is uploaded via
// Finix's own File API): mixing WGC-internal review/versioning fields into
// that table would risk an accidental Finix-facing code path picking up a
// row that was never meant to leave WGC. See assertNeverSentToFinix() in
// src/lib/onboarding/wgcInternalDocumentGuard.ts for the runtime guard.
model OnboardingInternalDocument {
  id                      String @id @default(cuid())
  onboardingApplicationId String
  documentType            String @default("IRS_501C3_DETERMINATION_LETTER")
  category                String @default("WGC_INTERNAL")
  title                   String @default("501(c)(3) IRS Determination Letter")

  originalFilename String
  storageProvider  String @default("supabase_storage")
  // Private-bucket object path — never a public/signed URL. Access is only
  // ever granted via a freshly generated, short-lived signed URL at
  // view/download time (see the admin access route).
  storageKey       String
  mimeType         String
  sizeBytes        Int
  checksum         String // sha256 hex of the uploaded bytes

  status String @default("UPLOADED") // UPLOADED | UNDER_REVIEW | VERIFIED_BY_WGC | NEEDS_REPLACEMENT | REJECTED

  // Simple version chain per onboardingApplicationId — a replacement
  // creates a new row and flips the prior current row's isCurrent to
  // false rather than overwriting it, so review history is preserved.
  version   Int     @default(1)
  isCurrent Boolean @default(true)

  uploadedByUserId String? // set for admin-on-behalf uploads; null for the organization's own pre-Church upload (no user session exists yet)
  uploadedAt       DateTime @default(now())

  reviewedByUserId          String?
  reviewedAt                DateTime?
  organizationFacingMessage String? // shown to the organization
  internalReviewNotes       String? // wgc_admin only, never shown to the organization

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  onboardingApplication OnboardingApplication @relation(fields: [onboardingApplicationId], references: [id], onDelete: Cascade)

  @@index([onboardingApplicationId])
}

model AssociatedOwner {
  id                        String                @id @default(cuid())
  onboardingApplicationId   String
  finixAssociatedIdentityId String?
  firstName                 String
  lastName                  String
  title                     String?
  email                     String
  phone                     String?
  dobYear                   Int?
  dobMonth                  Int?
  dobDay                    Int?
  ownershipPercentage       Int?
  addressLine1              String?
  addressLine2              String?
  city                      String?
  state                     String?
  postalCode                String?
  country                   String?
  taxIdProvided             Boolean               @default(false)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  onboardingApplication     OnboardingApplication @relation(fields: [onboardingApplicationId], references: [id])
}

model LegalAcceptance {
  id                      String    @id @default(cuid())
  onboardingApplicationId String
  acceptedWgcTermsAt      DateTime?
  acceptedWgcFeesAt       DateTime?
  acceptedWgcPrivacyAt    DateTime?
  acceptedFinixTermsAt    DateTime?
  acceptedFinixPrivacyAt  DateTime?
  accepterName            String
  accepterEmail           String
  accepterIpAddress       String?
  accepterUserAgent       String?
  wgcTermsVersion         String
  wgcFeesVersion          String
  wgcPrivacyVersion       String
  finixTermsUrl           String
  finixPrivacyUrl         String
  source                  String
  createdAt               DateTime  @default(now())
}

model FinixWebhookEvent {
  id                String    @id @default(cuid())
  finixEventId      String    @unique
  entity            String?
  type              String
  occurredAt        DateTime?
  merchantId        String?
  identityId        String?
  verificationId    String?
  onboardingState   String?
  verificationState String?
  rawPayloadJson    Json
  processedAt       DateTime?
  processingStatus  String    @default("PENDING")
  errorMessage      String?
  createdAt         DateTime  @default(now())

  @@index([merchantId])
  @@index([processingStatus])
  @@index([createdAt])
}

model MerchantDocument {
  id                      String                @id @default(cuid())
  onboardingApplicationId String
  documentType            String
  fileName                String
  fileSize                Int
  mimeType                String
  uploadStatus            String
  finixFileId             String?
  uploadedBy              String
  createdAt               DateTime              @default(now())
  onboardingApplication   OnboardingApplication @relation(fields: [onboardingApplicationId], references: [id], onDelete: Cascade)
}

model EmailLog {
  id                      String    @id @default(cuid())
  onboardingApplicationId String?
  type                    String
  to                      String
  subject                 String
  status                  String
  providerMessageId       String?
  error                   String?
  sentAt                  DateTime?
  createdAt               DateTime  @default(now())
}

/// Submissions from the public /contact "Inquiry Registry" form. Persisted
/// so a submission is recoverable even if the notification email fails —
/// the form previously had no backend at all (no action/onSubmit/API), so
/// every prior submission was silently lost before this model existed.
model ContactInquiry {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String
  phone        String?
  company      String?
  role         String?
  subject      String?
  message      String
  emailSent    Boolean  @default(false)
  emailError   String?
  // NEW | REVIEWED | CONTACTED | CLOSED — internal admin triage status,
  // ported from the live internal admin inquiries workflow.
  status       String   @default("NEW")
  internalNote String?
  reviewedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

model AuditLog {
  id                      String   @id @default(cuid())
  onboardingApplicationId String?
  action                  String
  actorEmail              String?
  ipAddress               String?
  userAgent               String?
  metadata                Json?
  createdAt               DateTime @default(now())
}

model Church {
  id                            String    @id @default(cuid())
  name                          String
  slug                          String    @unique
  primaryContactEmail           String
  onboardingApplicationId       String?
  finixMerchantId               String?
  finixIdentityId               String?
  finixApplicationId            String?
  // WGC platform-billing gate, checked on every dashboard request (denormalized
  // here for a fast session-level check rather than joining WgcSubscription on
  // every request). Null = grandfathered/no gate (organizations that existed
  // before this feature). APPROVED_BILLING_REQUIRED = Finix-approved but
  // billing/subscription setup not yet complete — dashboard access is
  // restricted to subscription setup, billing setup, support, account info,
  // and logout only (see requireMerchantSession's billing-gate check).
  // BILLING_ACTIVE = full dashboard access restored.
  billingSetupStatus            String?
  // Set once the org's WGC platform subscription goes PAST_DUE past its
  // configured grace period — a second, independent restriction from
  // billingSetupStatus (a fully-set-up org can still lapse into this state).
  billingAccessRestrictedAt     DateTime?
  // Team-access Checkpoint 1: exactly one User (role "owner") accountable
  // per Church. Nullable during migration — existing churches are backfilled
  // via an explicit, reviewed report (see ownerBackfillPreview), never
  // silently assigned. Deliberately a plain String FK-by-convention (no
  // Prisma @relation) to match this schema's existing style for User<->Church
  // cross-references (see User.invitedByUserId/disabledByUserId) and to keep
  // this migration additive-only.
  primaryOwnerUserId            String?
  status                        String
  // Organization identity used on annual donation statements and the
  // organization profile — not required by onboarding/payments, so all
  // nullable. Intentionally not backfilled from OnboardingApplication:
  // Church.onboardingApplicationId isn't a dependable join, so these are
  // populated going forward via an explicit organization-profile edit.
  addressLine1                  String?
  addressLine2                  String?
  city                          String?
  state                         String?
  postalCode                    String?
  country                       String?
  logoUrl                       String?
  taxId                         String?
  phone                         String?
  // Year-End Donation Statement configuration (Settings -> Receipts &
  // Annual Statements). All optional — generation falls back to sensible
  // defaults (DEFAULT_THANK_YOU_MESSAGE, STATEMENT_DISCLAIMER) when unset.
  statementSenderName           String?
  statementReplyToEmail         String?
  statementSubjectTemplate      String?
  statementThankYouMessage      String?
  statementDisclaimer           String?
  statementShowDonorCoveredFees Boolean   @default(false)
  statementShowTaxId            Boolean   @default(false)
  statementShowWebsite          Boolean   @default(false)
  // Optional authorized-signature block on year-end statements — a name/
  // title pair renders as a signature line even without an image; the image
  // (if provided) renders above them. All optional per organization.
  statementSignatureName        String?
  statementSignatureTitle       String?
  statementSignatureImageUrl    String?

  // General settings (Settings -> General). All optional/nullable —
  // display falls back to existing fields (name, primaryContactEmail) or
  // sensible defaults when unset, same pattern as statement settings above.
  publicDisplayName     String?
  organizationType      String? // NONPROFIT | MINISTRY | CHARITY | FAITH_BASED | COMMUNITY | FOUNDATION | RELIGIOUS | OTHER
  website               String?
  supportEmail          String?
  financeEmail          String?
  technicalContactEmail String?
  mailingAddressLine1   String?
  mailingAddressLine2   String?
  mailingCity           String?
  mailingState          String?
  mailingPostalCode     String?
  mailingCountry        String?
  timezone              String? // IANA zone, e.g. "America/Chicago" — falls back to Central Time when unset
  dateFormat            String? // e.g. "MM/DD/YYYY"
  fiscalYearStartMonth  Int? // 1-12
  publicSupportContact  String?

  // Giving settings (Settings -> Giving) — only the genuinely org-wide
  // pieces. Per-link amount/frequency/fee-cover config already lives on
  // GivingLink itself and is never duplicated here.
  defaultGivingLinkId String?
  givingTermsUrl      String?
  givingPrivacyUrl    String?
  givingSupportEmail  String?

  // Receipt settings (Settings -> Receipts). Mirrors the statement-settings
  // pattern: nullable, falls back to DEFAULT_RECEIPT_* constants when unset.
  receiptAutoSend                  Boolean @default(true)
  receiptSenderName                String?
  receiptReplyToEmail              String?
  receiptSubjectTemplate           String?
  receiptHeader                    String?
  receiptThankYouMessage           String?
  receiptFooter                    String?
  receiptShowAddress               Boolean @default(true)
  receiptShowPhone                 Boolean @default(false)
  receiptShowEmail                 Boolean @default(true)
  receiptShowFund                  Boolean @default(true)
  receiptShowDonorCoveredFee       Boolean @default(false)
  receiptShowPaymentMethodLastFour Boolean @default(true)
  receiptShowRecurringSchedule     Boolean @default(true)
  receiptShowDonationReference     Boolean @default(true)
  receiptShowTaxId                 Boolean @default(false)
  receiptShowWebsite               Boolean @default(false)
  receiptDisclaimer                String?
  receiptLanguage                  String? // default "en"
  receiptSendCopyToOrg             Boolean @default(false)
  receiptSupportContact            String?
  // Sequential-looking receipt number prefix, e.g. "RCPT" -> "RCPT-2026-AB12CD34".
  // Not a database counter — derived deterministically from the payment id,
  // so no cross-request coordination is needed and it's stable on resend.
  receiptNumberPrefix              String? @default("RCPT")

  // Acknowledgment / tax-compliance wording (Settings -> Receipts). Shared
  // between individual receipts and year-end statements. Never hardcoded in
  // UI or PDF templates — every organization can rewrite this to match its
  // own tax counsel's guidance; these are only the built-in starting
  // defaults, applied by resolveAcknowledgmentSettings() when unset.
  acknowledgmentNoGoodsServicesText   String?
  // Supports [DESCRIPTION] and [VALUE] tokens, replaced with the per-payment
  // (or, for statements, per-line) goods/services description and formatted
  // fair-market-value amount when a contribution had goods or services
  // provided in exchange.
  acknowledgmentGoodsServicesTemplate String?

  // Branding (Settings -> Branding). logoUrl already existed; colors/favicon
  // are net-new, no schema precedent before this.
  faviconUrl     String?
  primaryColor   String? // hex, e.g. "#0f172a"
  secondaryColor String?
  accentColor    String?
  promotion      String?

  // Website Embed (Settings -> Website Embed). Domain restriction is
  // opt-in and off by default so embeds work on any site with zero setup;
  // when enabled, embedAllowedDomainsJson (string[] of hostnames, e.g.
  // ["church.org","www.church.org"]) is checked server-side against the
  // embedding page's Referer in src/lib/giving/embedDomainCheck.ts.
  embedDomainRestrictionEnabled Boolean @default(false)
  embedAllowedDomainsJson       Json?

  // Seeds GivingLink.collectMailingAddress when a merchant creates a NEW
  // giving link — this only affects new links going forward, never an
  // existing link's already-set value.
  defaultCollectMailingAddressOnNewLinks Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notificationPreferences NotificationPreference[]
  organizationContacts    OrganizationContact[]
  supportTickets          SupportTicket[]
  bankAccounts            OrganizationBankAccount[]
  complianceForms         ComplianceForm[]
  synchronizationStates   SynchronizationState[]
  aplosConnection         AplosConnection?

  @@unique([onboardingApplicationId])
  @@index([finixMerchantId])
}

/// Mirrors Finix's `Compliance Form` resource (PCI SAQ attestation). Finix
/// creates these automatically per Merchant — we never create one, only
/// sync (webhook + reconciliation fallback) and attest (PUT) to the one
/// Finix already made. `finixComplianceFormId` is Finix's own ID
/// (e.g. "cf_..."), never generated locally.
model ComplianceForm {
  id                    String    @id @default(cuid())
  finixComplianceFormId String    @unique
  churchId              String
  finixMerchantId       String
  type                  String // PCI_SAQ_A
  version               String?
  state                 String // INCOMPLETE | OVERDUE | COMPLETE | EXPIRED | INVALID
  dueAt                 DateTime?
  validFrom             DateTime?
  validUntil            DateTime?
  unsignedFileId        String?
  signedFileId          String?
  signeeName            String?
  signeeTitle           String?
  signeeIpAddress       String?
  signeeUserAgent       String?
  signedAt              DateTime?
  isAccepted            Boolean   @default(false)
  createdAtFinix        DateTime?
  updatedAtFinix        DateTime?
  lastReconciledAt      DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([churchId])
  @@index([state])
}

/// The organization's payout bank account(s) on file (Finix calls this a
/// bank Payment Instrument tied to the org's seller Identity — confirmed via
/// audit that a Payment Instrument cannot move between Identities). No
/// confirmed Finix API exists in this codebase to programmatically flip
/// which instrument is the seller's active payout destination, so activation
/// is tracked here as a status that only advances via real signals (webhook
/// / reconciliation of the instrument's own state) and, when the API gap
/// blocks final activation, an auto-flagged exception rather than a routine
/// manual-approval queue. Never delete a row — history must be preserved.
model OrganizationBankAccount {
  id                       String    @id @default(cuid())
  churchId                 String
  finixPaymentInstrumentId String?
  sellerIdentityId         String? // the seller Identity this instrument was created under — confirms it was never attached to the wrong Identity
  bankName                 String?
  accountHolderName        String?
  last4                    String?
  accountType              String? // CHECKING | SAVINGS
  currency                 String?
  fingerprint              String? // Finix's processor-computed fingerprint, when returned — used to detect a duplicate bank account before creating a redundant one; a null value here just means Finix didn't return one, not that dedup is guaranteed
  // Four intentionally separate state concepts (never conflated):
  // 1. paymentInstrumentState — raw instrument state as Finix reports it
  //    (ENABLED/DISABLED/PENDING), independent of payout-destination status.
  // 2. verificationState — whether Finix has verified this specific
  //    instrument (NOT_STARTED/PENDING/VERIFIED/REJECTED). Verified does
  //    NOT mean active — see isActivePayoutDestination.
  // 3. payoutDestinationState (the `status` column, kept named `status` for
  //    schema stability) — the WGC-facing lifecycle label: CURRENT |
  //    SUBMITTED | PENDING_VERIFICATION | UNDER_REVIEW | REQUIRES_ACTION |
  //    APPROVED | ACTIVE | REJECTED | DISABLED | HISTORICAL | UNKNOWN.
  // 4. isActiveDestination (exposed to API/UI as isActivePayoutDestination)
  //    — the single boolean answer to "is this the account payouts go to."
  status                   String    @default("SUBMITTED")
  paymentInstrumentState   String? // raw Finix instrument state (ENABLED/DISABLED/PENDING)
  verificationState        String? // NOT_STARTED | PENDING | VERIFIED | REJECTED — separate from payoutDestinationState
  isActiveDestination      Boolean   @default(false)
  addedAt                  DateTime  @default(now())
  validationStartedAt      DateTime?
  reviewStartedAt          DateTime?
  verifiedAt               DateTime?
  activatedAt              DateTime?
  rejectedAt               DateTime?
  disabledAt               DateTime?
  replacedAt               DateTime?
  replacedByAccountId      String?
  createdByUserId          String?
  changeReason             String?
  verificationMethod       String? // e.g. "PROCESSOR_REVIEW" | "SUPPORT_REVIEW" — the latter only when the API can't confirm activation
  supportTicketId          String?
  lastSyncedAt             DateTime? // last time we checked (webhook or reconciliation)
  lastWebhookAt            DateTime?
  retryCount               Int       @default(0)
  failureCode              String?
  failureMessageSafe       String? // never a raw processor payload — a short, safe summary only
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  church                   Church                       @relation(fields: [churchId], references: [id])
  changeRequestsAsCurrent  PayoutAccountChangeRequest[] @relation("CurrentAccount")
  changeRequestsAsProposed PayoutAccountChangeRequest[] @relation("ProposedAccount")
  documents                PayoutAccountDocument[]

  @@index([churchId, isActiveDestination])
  @@index([churchId, status])
  @@index([finixPaymentInstrumentId])
}

/// Documents uploaded for a REQUIRES_ACTION payout account. Finix does not
/// expose a structured "these exact document types are required" field
/// anywhere in this codebase's confirmed API surface — `failureMessageSafe`
/// on the account carries whatever safe reason text the processor gave, and
/// the admin uploads whatever they were asked for under a free-text label
/// they choose, rather than this app guessing/hardcoding a fixed list.
model PayoutAccountDocument {
  id                        String   @id @default(cuid())
  organizationBankAccountId String
  label                     String? // e.g. "Voided Check" — freely entered by the admin, never a hardcoded enum
  fileName                  String
  fileSize                  Int
  mimeType                  String
  finixFileId               String?
  uploadedByUserId          String?
  createdAt                 DateTime @default(now())

  organizationBankAccount OrganizationBankAccount @relation(fields: [organizationBankAccountId], references: [id])

  @@index([organizationBankAccountId])
}

/// Tracks a single payout-bank-account change request end-to-end, separate
/// from the account rows themselves, so the request's own lifecycle
/// (idempotency, consent, processor reference) doesn't get conflated with
/// the account's own long-lived state.
model PayoutAccountChangeRequest {
  id                        String    @id @default(cuid())
  churchId                  String
  currentAccountId          String?
  proposedAccountId         String?
  requestedByUserId         String?
  state                     String    @default("SUBMITTED") // SUBMITTED | VALIDATION_PENDING | UNDER_REVIEW | VERIFIED | ACTIVATED | REJECTED | FAILED | SUPPORT_REVIEW_REQUIRED
  idempotencyKey            String    @unique
  consentSnapshot           String? // the exact confirmation text the admin agreed to, for audit
  processorRequestReference String? // finixPaymentInstrumentId of the proposed account, once created
  submittedAt               DateTime  @default(now())
  completedAt               DateTime?
  failedAt                  DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  currentAccount  OrganizationBankAccount? @relation("CurrentAccount", fields: [currentAccountId], references: [id])
  proposedAccount OrganizationBankAccount? @relation("ProposedAccount", fields: [proposedAccountId], references: [id])

  @@index([churchId, state])
}

/// One row per (organization, event type) — the org-wide notification
/// preference for that event. No per-user targeting yet since there is
/// currently only one real visible role (Organization Admin); recipients
/// are simply "all Organization Admins for this organization" until a
/// richer team model exists.
model NotificationPreference {
  id           String   @id @default(cuid())
  churchId     String
  eventKey     String // e.g. "NEW_DONATION", "FAILED_PAYMENT", ...
  inAppEnabled Boolean  @default(true)
  emailEnabled Boolean  @default(true)
  frequency    String   @default("IMMEDIATE") // IMMEDIATE | DAILY_DIGEST | WEEKLY_DIGEST
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  church Church @relation(fields: [churchId], references: [id])

  @@unique([churchId, eventKey])
}

/// A named contact role for the organization (Settings/Organization Profile
/// -> Contacts). Distinct from User (login accounts) — a contact need not
/// have dashboard access.
model OrganizationContact {
  id        String   @id @default(cuid())
  churchId  String
  role      String // PRIMARY | FINANCE | TECHNICAL | SUPPORT | AUTHORIZED_SIGNER | STATEMENT | SECURITY
  name      String
  email     String?
  phone     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  church Church @relation(fields: [churchId], references: [id])

  @@index([churchId, role])
}

/// A support request from an Organization Admin to WGC. Entirely new —
/// no prior support-ticket model existed anywhere in this schema.
model SupportTicket {
  id                     String    @id @default(cuid())
  // Human-readable "WGC-1001" style number — generated once at creation,
  // never reused. Unique so concurrent creation can never collide (the
  // create call retries on a unique-constraint violation instead of
  // pre-reserving a number under a lock).
  ticketNumber           String    @unique
  churchId               String
  subject                String
  category               String // PAYMENT | REFUND | BANK_RETURN | DISPUTE | SETTLEMENT | DEPOSIT | SUBSCRIPTION | RECURRING_DONOR | DONOR | GIVING_LINK | ANNUAL_STATEMENT | FEES | ACCOUNT_ACCESS | SECURITY | VERIFICATION | INTEGRATION | OTHER
  description            String
  priority               String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  status                 String    @default("OPEN") // OPEN | IN_PROGRESS | WAITING_ON_ORGANIZATION | WAITING_ON_SUPPORT | RESOLVED | CLOSED
  preferredContactMethod String? // EMAIL | PHONE
  contactEmail           String?
  contactPhone           String?
  relatedResourceType    String? // PAYMENT | REFUND | BANK_RETURN | DISPUTE | SETTLEMENT | DEPOSIT | SUBSCRIPTION | DONOR | GIVING_LINK | ANNUAL_STATEMENT
  relatedResourceId      String?
  diagnosticConsent      Boolean   @default(false)
  diagnosticContextJson  Json? // safe context only: route, app version, recent sync status — never credentials/payloads
  createdByUserId        String?
  createdByEmail         String?
  assignedTeam           String    @default("WGC Support")
  // Internal WGC admin (User.role wgc_admin/wgc_super_admin) currently
  // working this ticket — separate from assignedTeam (a free-text label).
  // Null until an admin claims it.
  assignedToAdminUserId  String?
  resolvedAt             DateTime?
  closedAt               DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  church   Church                 @relation(fields: [churchId], references: [id])
  messages SupportTicketMessage[]

  @@index([churchId, status])
  @@index([churchId, createdAt])
  @@index([assignedToAdminUserId])
}

model SupportTicketMessage {
  id               String    @id @default(cuid())
  ticketId         String
  senderRole       String // church_admin | wgc_admin | system
  senderUserId     String?
  senderEmail      String?
  body             String
  // Internal-admin-only note — never returned by a merchant-facing API,
  // never rendered in the merchant dashboard, never emailed to a merchant.
  isInternalNote   Boolean   @default(false)
  // Read-receipt timestamps for the unread-count badges — set once, on
  // the first view by that side, never cleared/reset.
  readByMerchantAt DateTime?
  readByAdminAt    DateTime?
  isSystemEvent    Boolean   @default(false) // status changes, ticket resolved/reopened, etc — rendered distinctly from a human reply
  createdAt        DateTime  @default(now())

  ticket      SupportTicket             @relation(fields: [ticketId], references: [id])
  attachments SupportTicketAttachment[]

  @@index([ticketId, createdAt])
}

model SupportTicketAttachment {
  id          String   @id @default(cuid())
  messageId   String
  fileName    String
  fileSize    Int
  mimeType    String
  finixFileId String? // stored via the same Finix File Resource pattern used by onboarding document uploads — never a raw local/S3 path
  createdAt   DateTime @default(now())

  message SupportTicketMessage @relation(fields: [messageId], references: [id])

  @@index([messageId])
}

model Donor {
  id                     String    @id @default(cuid())
  churchId               String
  name                   String?
  email                  String?
  // Lowercased/trimmed copy of `email`, indexed for matching/dedup — `email`
  // itself stays exactly as entered for display.
  normalizedEmail        String?
  phone                  String?
  // E.164-normalized copy of `phone` where the input is a recognizable US
  // number — `phone` itself stays exactly as entered for display.
  normalizedPhone        String?
  addressLine1           String?
  addressLine2           String?
  city                   String?
  state                  String?
  postalCode             String?
  country                String?
  // How this address was obtained — ONLINE_DONATION_FORM |
  // MERCHANT_MANUAL_ENTRY | EXTERNAL_DONATION | DONOR_PORTAL | CRM_IMPORT |
  // CSV_IMPORT | DONATION_ENVELOPE | CHECK | PLEDGE_FORM |
  // EXISTING_ORGANIZATION_RECORD | OTHER. Merchant-facing only — never
  // shown on a donor receipt or statement.
  addressSource          String?
  // UNVERIFIED | CONFIRMED_BY_DONOR | CONFIRMED_BY_ORG. Never set to a
  // confirmed value merely because the address passed format validation —
  // only an explicit donor submission or merchant confirmation action sets
  // this away from UNVERIFIED.
  addressVerified        String    @default("UNVERIFIED")
  lastAddressConfirmedAt DateTime?
  // Set automatically whenever any address field changes — distinct from
  // the row-level `updatedAt` so "when did the mailing address last change"
  // survives edits to unrelated donor fields (name, phone, notes, etc.).
  addressUpdatedAt       DateTime?
  addressUpdatedByUserId String?
  companyName            String?
  // Donor-level display preference, distinct from Payment.isAnonymous
  // (a per-payment flag) — this is "always show this donor as anonymous."
  anonymousPreference    Boolean   @default(false)
  finixIdentityId        String?   @unique
  archivedAt             DateTime?
  archivedByUserId       String?
  archivedByEmail        String?
  // Set when this donor record was merged into another (the survivor).
  // A merged donor is archived and never deleted — financial history stays
  // attached to it, so nothing here is ever hard-deleted.
  mergedIntoDonorId      String?
  mergedAt               DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([churchId])
  @@index([normalizedEmail])
  @@index([normalizedPhone])
  @@index([createdAt])
  @@index([archivedAt])
}

/// A confidence-scored candidate match between a newly-entered/imported
/// donor and an existing Donor row, raised when the automatic exact-match
/// resolver (resolveOrCreateDonor: email/phone/finixIdentityId) finds no
/// exact match but a fuzzy comparison (name+address, name+partial phone,
/// name+similar email) crosses the MEDIUM-confidence bar. Never created
/// for a HIGH-confidence exact match (that auto-attaches immediately,
/// same as always) or for a bare name-only LOW match (that creates a new
/// donor with no review needed, per the "never merge on name alone" rule).
/// A record here does not itself change any donation's donorId — the new
/// donor row is created normally so the gift is never blocked or lost;
/// this table only tracks that a human should confirm whether the two
/// donor rows are actually the same person.
model PossibleDonorMatch {
  id       String @id @default(cuid())
  churchId String

  // The pre-existing donor this new record might be the same person as.
  existingDonorId  String
  // The newly created donor row raised against existingDonorId — created
  // immediately (never blocked pending review), reassigned into
  // existingDonorId via the normal mergeDonors() flow only if a reviewer
  // confirms the match.
  candidateDonorId String

  // EXTERNAL_DONATION_ENTRY | EXTERNAL_DONATION_IMPORT — the only two
  // paths that currently run fuzzy scoring (see donorMatchConfidence.ts
  // doc comment for why the public Finix checkout path never does).
  sourceType String
  // ExternalDonation.id (entry) or ExternalDonationImportBatch.id (import)
  sourceId   String?

  confidence        String // MEDIUM (HIGH auto-attaches, LOW never rows here)
  confidenceScore   Int // 0-100, informational — confidence is the decision boundary
  matchedFields     String[]
  conflictingFields String[]
  matchReason       String

  donationAmountCents Int?
  donationDate        DateTime?

  // PENDING | CONFIRMED | REJECTED | SKIPPED
  status           String    @default("PENDING")
  reviewedByUserId String?
  reviewedByEmail  String?
  reviewedAt       DateTime?
  resolutionNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([churchId, status])
  @@index([existingDonorId])
  @@index([candidateDonorId])
}

// Multiple free-text internal notes per donor, each with its own author/
// timestamp — distinct from the single-overwritable-field pattern used by
// FinixDispute.internalNote. Never sent to the donor or the processor.
model DonorNote {
  id              String    @id @default(cuid())
  donorId         String
  churchId        String
  body            String
  createdByUserId String?
  createdByEmail  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([donorId])
  @@index([churchId])
}

// A named designation donations can be attributed to (e.g. "Building Fund",
// "General Fund"). Introduced to replace the free-text fundName strings on
// Payment/PaymentAttempt/GivingLink with a real per-organization entity —
// fundName itself is left in place on those models for backward
// compatibility; fundId is the new relationship going forward.
model Fund {
  id           String   @id @default(cuid())
  churchId     String
  name         String
  description  String?
  isActive     Boolean  @default(true)
  // Church-wide catalog ordering (e.g. the org's "Manage Funds" list).
  // Per-giving-link dropdown order is separate — see GivingLinkFund.displayOrder.
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([churchId, name])
  @@index([churchId])
}

// Gift Designations: many-to-many assignment of a church's Fund catalog to
// a specific GivingLink, with per-link ordering/default independent of the
// fund's own catalog order. A fund can be assigned to multiple giving
// links; a giving link can offer multiple funds. Deliberately a thin join
// table (no soft-delete of its own) — removing an assignment here only
// stops the fund from being offered on this link going forward, it never
// touches Payment.fundId/fundName snapshots already recorded.
model GivingLinkFund {
  id           String   @id @default(cuid())
  givingLinkId String
  fundId       String
  isDefault    Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([givingLinkId, fundId])
  @@index([givingLinkId])
  @@index([fundId])
}

model Payment {
  id                                String    @id @default(cuid())
  churchId                          String
  donorId                           String?
  givingPageId                      String?
  givingLinkId                      String?
  finixTransferId                   String?
  finixBuyerIdentityId              String?
  finixPaymentInstrumentId          String?
  amountCents                       Int
  donationAmountCents               Int?
  feeCoveredCents                   Int?
  currency                          String    @default("USD")
  paymentMethodType                 String
  status                            String
  failureCode                       String?
  failureMessage                    String?
  failedAt                          DateTime?
  idempotencyId                     String?
  fraudSessionId                    String?
  receiptStatus                     String?
  receiptSentAt                     DateTime?
  // Latest receipt number/status cache — mirrors the current (non-superseded)
  // DonationReceipt row for this payment. DonationReceipt is the source of
  // truth for the full version history; these two fields exist so payment
  // list/detail views don't need an extra join for the common case.
  receiptNumber                     String?
  // Quid-pro-quo disclosure for this specific contribution, entered by the
  // admin taking the payment (or corrected afterward — see DonationReceipt
  // for the immutable per-version snapshot actually shown to the donor).
  // goodsServicesProvided is the authoritative flag; description/value are
  // only meaningful when it's true.
  goodsServicesProvided             Boolean   @default(false)
  goodsServicesDescription          String?
  goodsServicesFairMarketValueCents Int?
  // Staff-only context for why/what was recorded — never shown on the donor
  // receipt.
  goodsServicesInternalNote         String?
  // paymentAmountCents - goodsServicesFairMarketValueCents (0 when nothing
  // was provided). For acknowledgment/record-keeping purposes only — not a
  // computed tax deduction.
  recordedContributionAmountCents   Int?
  acknowledgmentConfiguredByUserId  String?
  acknowledgmentConfiguredAt        DateTime?
  achAuthorizationAccepted          Boolean   @default(false)
  achAuthorizationAcceptedAt        DateTime?
  fundName                          String?
  fundId                            String?
  // Set when this payment fulfills (fully or partially) a campaign Pledge —
  // either via the public campaign page's "Give now" flow or a merchant
  // linking an existing payment as evidence. Server-validated to belong to
  // the same church before being trusted; see donate/route.ts. Never blocks
  // the donation if the pledge lookup fails — the donation still succeeds
  // untagged. See the Pledges section below for the full model.
  pledgeId                          String?
  note                              String?
  isAnonymous                       Boolean   @default(false)
  createdByAdminUserId              String?
  // Team-access Checkpoint 3: snapshotted once at payment-creation time from
  // GivingLink.ownerUserId (public donation) or the acting admin/explicit
  // assignment (Take a Payment flow) — never re-derived later. Stays null
  // when attribution can't be proven (no giving link, unowned link, missing
  // owner) rather than falling back to the church's primary owner. A later
  // giving-link reassignment does NOT rewrite this field — see
  // GivingLink.ownerUserId's comment. Reporting-only: never used to select
  // a Finix merchant, identity, settlement destination, or bank account —
  // those always come from Church.finixMerchantId/finixIdentityId. Plain
  // string FK-by-convention (no @relation), matching this schema's existing
  // style for User cross-references (see Church.primaryOwnerUserId) —
  // there are currently zero Prisma relations between User and any other
  // model in this schema, so adding one only here would be the first,
  // inconsistent exception rather than following an established pattern.
  attributedUserId                  String?
  paymentAttemptId                  String?
  donorCoversFee                    Boolean?
  cardBrand                         String?
  percentageBps                     Int?
  fixedFeeCents                     Int?
  feeCalculationVersion             String?
  merchantExpectedNetCents          Int?
  actualFinixFeesCents              Int?
  finixSubscriptionId               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receipts DonationReceipt[]

  @@index([churchId, attributedUserId])
  @@index([donorId])
  @@index([finixTransferId])
  @@index([churchId, status])
  @@index([churchId, createdAt])
  @@index([churchId, pledgeId])
}

// One immutable snapshot per receipt version sent (or prepared) for a
// Payment — mirrors the AnnualDonationStatement versioning pattern
// (immutable snapshot + supersededAt) rather than mutating a single row in
// place, so a correction after a receipt has already been sent to a donor
// never silently rewrites what they were shown. version 1 is the original;
// any correction creates version 2, 3, ... and marks the prior
// non-superseded row supersededAt.
model DonationReceipt {
  id            String @id @default(cuid())
  paymentId     String
  churchId      String
  version       Int    @default(1)
  receiptNumber String

  paymentAmountCentsSnapshot                Int
  goodsServicesProvidedSnapshot             Boolean @default(false)
  goodsServicesDescriptionSnapshot          String?
  goodsServicesFairMarketValueCentsSnapshot Int?
  recordedContributionAmountCentsSnapshot   Int?
  acknowledgmentTextSnapshot                String

  recipientEmail String?
  sentAt         DateTime?
  failureReason  String?
  supersededAt   DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([churchId])
}

// A payment attempt initiated by a church admin from the dashboard's "Take
// a Payment" flow, tracked from before the Finix API call is made so a
// browser retry / double-click / refresh can be recognized as the same
// logical attempt instead of minting a second charge. clientAttemptId is
// the stable key the frontend keeps across its own retries of one
// submission (a genuinely new attempt, e.g. hitting Retry after a failure,
// gets a fresh one). idempotencyId is generated here server-side exactly
// once per clientAttemptId and is the value actually sent to Finix.
model PaymentAttempt {
  id                String   @id @default(cuid())
  churchId          String
  adminUserId       String?
  donorId           String?
  givingLinkId      String?
  clientAttemptId   String   @unique
  idempotencyId     String   @unique
  amountCents       Int
  feeCents          Int?
  totalCents        Int
  paymentMethodType String
  fundName          String?
  fundId            String?
  note              String?
  isAnonymous       Boolean  @default(false)
  fraudSessionId    String?
  status            String // PROCESSING | PENDING | SUCCEEDED | FAILED | CANCELED
  finixTransferId   String?
  failureMessage    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// =========================================================================
// WGC Platform Billing (WGC charging its own client organizations for the
// platform subscription / invoice feature) — completely separate from any
// client organization's own Finix merchant, which only ever processes that
// organization's donations/invoices. Every charge here is routed through
// FINIX_WGC_BILLING_MERCHANT_ID via src/lib/billing/paymentRouting.ts,
// never a Church's own finixMerchantId. See docs/wgc-billing.md.
//
// Replaces the previously-scaffolded SubscriptionPlan/ChurchSubscription/
// SubscriptionCharge models, which were confirmed completely unwired (zero
// call sites beyond a throwing stub, zero rows) and removed rather than
// repurposed in place, since their shape didn't carry the fields this
// feature actually needs (trial dates, billing-merchant reference,
// idempotency keys, pricing-version linkage).
// =========================================================================

/// Versioned pricing for the WGC platform subscription itself (currently
/// $10/month). Never silently changes an existing organization's price —
/// a new version is added and WgcSubscription.priceVersionId keeps pointing
/// at whichever version it was created under.
model WgcPricingVersion {
  id                  String    @id @default(cuid())
  planCode            String
  planName            String
  monthlyAmountCents  Int
  currency            String    @default("USD")
  billingInterval     String    @default("MONTHLY")
  internalDescription String?
  customerDescription String?
  isDefaultForNewOrgs Boolean   @default(false)
  effectiveFrom       DateTime  @default(now())
  effectiveUntil      DateTime?
  // DRAFT | ACTIVE | RETIRED
  status              String    @default("DRAFT")
  createdByUserId     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([planCode, status])
}

/// A client organization's billing identity + payment instrument under
/// WGC's own Finix billing merchant — entirely separate from the
/// organization's own Finix identity/merchant (Church.finixIdentityId/
/// finixMerchantId) used for donations/invoices. One per organization.
model WgcBillingAccount {
  id                         String    @id @default(cuid())
  organizationId             String    @unique
  billingIdentityId          String?
  billingPaymentInstrumentId String?
  // CARD | BANK_ACCOUNT
  billingMethodType          String?
  cardBrand                  String?
  cardLast4                  String?
  cardExpMonth               Int?
  cardExpYear                Int?
  bankLast4                  String?
  maskedBillingDetails       String?
  billingContactEmail        String?
  authorizationAcceptedAt    DateTime?
  authorizationTermsVersion  String?
  authorizationIpAddress     String?
  authorizationUserAgent     String?
  authorizingUserId          String?
  // PENDING | ACTIVE | REPLACED | INVALID
  status                     String    @default("PENDING")
  lastUpdatedByUserId        String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([organizationId])
}

/// The organization's WGC platform subscription — a Finix Subscription
/// billed through WGC's OWN Finix billing merchant, never the
/// organization's own merchant. Application logic (not a DB constraint)
/// enforces at most one active/trialing subscription per organization —
/// see resolveOrCreateWgcSubscription's transaction lock.
model WgcSubscription {
  id                         String    @id @default(cuid())
  // One row per organization for the lifetime of the account — reactivating
  // after cancellation updates this same row (new finixSubscriptionId etc.)
  // rather than creating a second row, which is also what makes the
  // upsert-by-organizationId pattern in wgcSubscriptionService.ts an atomic
  // duplicate-activation guard (see "duplicate activation does not create
  // duplicate subscriptions").
  organizationId             String    @unique
  planCode                   String
  priceVersionId             String
  finixSubscriptionId        String?   @unique
  finixBillingMerchantId     String
  billingIdentityId          String?
  billingPaymentInstrumentId String?
  amountCents                Int
  currency                   String    @default("USD")
  billingInterval            String    @default("MONTHLY")
  // INCOMPLETE | TRIALING | ACTIVE | PAST_DUE | CANCELED
  status                     String    @default("INCOMPLETE")
  trialStartsAt              DateTime?
  trialEndsAt                DateTime?
  firstChargeAt              DateTime?
  nextChargeAt               DateTime?
  lastChargeAt               DateTime?
  pastDueAt                  DateTime?
  gracePeriodEndsAt          DateTime?
  cancelRequestedAt          DateTime?
  canceledAt                 DateTime?
  canceledByUserId           String?
  cancellationReason         String?
  lastSyncedAt               DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([organizationId])
  @@index([status])
}

/// A defined promotional offer template (e.g. "Six Months Free"). Editing
/// this template must never retroactively change an already-granted
/// PromotionEntitlement — entitlements snapshot their own terms at grant
/// time (see PromotionEntitlement.durationMonths etc.).
model Promotion {
  id                               String    @id @default(cuid())
  code                             String    @unique
  name                             String
  customerDescription              String?
  durationMonths                   Int
  normalMonthlyAmountCents         Int
  active                           Boolean   @default(true)
  validFrom                        DateTime  @default(now())
  validUntil                       DateTime?
  // Which automatic source, if any, may grant this without admin action —
  // e.g. "LANDING_PAGE_SIX_MONTHS_FREE". Null = admin-grant only.
  automaticEligibilitySource       String?
  maxOrganizations                 Int?
  allowManualGrantToExistingOrg    Boolean   @default(false)
  promotionWaivesPlatformFee       Boolean   @default(true)
  promotionWaivesInvoiceMonthlyFee Boolean   @default(false)
  promotionWaivesInvoiceUsageFee   Boolean   @default(false)
  createdByUserId                  String?
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt

  @@index([code])
}

/// The organization-level grant of a Promotion — belongs to the
/// organization, never a user. Adding, removing, or changing sub-users must
/// never create, reset, extend, or remove this.
model PromotionEntitlement {
  id                        String    @id @default(cuid())
  organizationId            String
  promotionId               String
  // LANDING_PAGE_AUTOMATIC | ADMIN_APPROVED_CURRENT_CLIENT |
  // ADMIN_PROMOTION_EXTENSION | CUSTOM_CONTRACT
  source                    String
  // LEAD_CAPTURED | SIGNUP_STARTED | ACCOUNT_CREATED |
  // FINIX_ONBOARDING_STARTED | AWAITING_FINIX_APPROVAL |
  // MORE_INFORMATION_REQUIRED | AWAITING_BILLING_SETUP | ACTIVE |
  // ENDING_SOON | COMPLETED | CANCELED | EXPIRED_UNUSED | INELIGIBLE
  status                    String    @default("LEAD_CAPTURED")
  // Snapshotted from Promotion at grant time so a later template edit never
  // silently changes an already-granted entitlement.
  durationMonths            Int
  normalMonthlyAmountCents  Int
  waivesPlatformFee         Boolean   @default(true)
  waivesInvoiceMonthlyFee   Boolean   @default(false)
  waivesInvoiceUsageFee     Boolean   @default(false)
  grantedAt                 DateTime  @default(now())
  startsAt                  DateTime?
  endsAt                    DateTime?
  firstPaidBillingDate      DateTime?
  grantedByUserId           String?
  approvalReason            String?
  customerFacingExplanation String?
  canceledAt                DateTime?
  canceledByUserId          String?
  completedAt               DateTime?
  originalLeadId            String?
  finixSubscriptionId       String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([organizationId])
  @@index([status])
}

/// One row per organization per calendar month where a monthly compliance
/// check (see promoShortfallDetection.ts) found the org's actual Finix
/// processing volume fell below the promo's minimum-processing threshold
/// while its PromotionEntitlement was ACTIVE. Deliberately review-first, not
/// auto-charged: the row starts FLAGGED and a WGC billing admin must
/// explicitly charge or waive it (see promoShortfallCharge.ts) — nothing
/// automatically moves money. @@unique on (organizationId, billingPeriod)
/// is the hard guarantee against the detection cron ever double-flagging
/// (and therefore double-charging) the same org for the same month, even if
/// the cron somehow runs twice.
model PromoShortfallCharge {
  id                     String    @id @default(cuid())
  organizationId         String
  promotionEntitlementId String
  // e.g. "2026-09" — the calendar month that was found short.
  billingPeriod          String
  processedVolumeCents   Int
  thresholdCents         Int
  // Snapshotted from PromotionEntitlement.normalMonthlyAmountCents at
  // detection time — the amount an admin's "Charge now" action will
  // actually charge, immune to a later pricing-template edit.
  chargeAmountCents      Int
  currency               String    @default("USD")
  // FLAGGED | CHARGED | CHARGE_FAILED | WAIVED
  status                 String    @default("FLAGGED")
  finixTransferId        String?
  billingChargeId        String?
  chargedByUserId        String?
  chargedAt              DateTime?
  waivedByUserId         String?
  waivedAt               DateTime?
  waiveReason            String?
  failureMessage         String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([organizationId, billingPeriod])
  @@index([status])
  @@index([organizationId])
}

/// A promotional signup lead, captured server-side the moment a visitor
/// clicks "Start Six Months Free" on the trusted /six-months-free landing
/// page — never derived from a client-submitted query parameter, cookie
/// value, or hidden form field. Tracks the lead through signup -> Finix
/// approval -> billing setup.
model PromotionLead {
  id                      String    @id @default(cuid())
  organizationName        String?
  contactName             String?
  contactEmail            String?
  contactPhone            String?
  campaignSource          String?
  promotionId             String
  // Hash of the signed one-time signup token issued to this lead — the raw
  // token itself is never stored.
  tokenHash               String    @unique
  tokenExpiresAt          DateTime
  consumedAt              DateTime?
  signupStartedAt         DateTime?
  // Set as soon as signup creates the OnboardingApplication row — the
  // practical link that carries the promotion through Finix approval,
  // since Church itself doesn't exist until provisionChurchAccount runs
  // post-approval (organizationId below is set at that later point).
  onboardingApplicationId String?
  organizationId          String?
  finixApplicationId      String?
  lastActivityAt          DateTime  @default(now())
  // LEAD_CAPTURED | SIGNUP_STARTED | ACCOUNT_CREATED | EXPIRED | CONSUMED
  status                  String    @default("LEAD_CAPTURED")
  ipAddress               String?
  userAgent               String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([promotionId])
  @@index([organizationId])
  @@index([tokenExpiresAt])
}

/// Every WGC-billing-merchant charge (platform subscription, invoice add-on/
/// usage, plan upgrade, promotional credit, refund) — never a client
/// organization's own donation/invoice charge, which stays in Payment/
/// FinixTransfer/InvoicePayment, processed through the organization's own
/// merchant.
model BillingCharge {
  id                  String    @id @default(cuid())
  organizationId      String
  // WGC_PLATFORM_SUBSCRIPTION | WGC_INVOICE_ADD_ON | WGC_INVOICE_USAGE |
  // WGC_PLAN_UPGRADE | PROMOTIONAL_CREDIT | BILLING_ADJUSTMENT | REFUND
  chargeType          String
  // e.g. "2027-02" for a monthly billing period; null for one-off charges.
  billingPeriod       String?
  amountCents         Int
  currency            String    @default("USD")
  finixTransferId     String?
  finixSubscriptionId String?
  pricingVersionId    String?
  idempotencyKey      String    @unique
  // PENDING | SUCCEEDED | FAILED | REFUNDED | RECONCILING
  status              String    @default("PENDING")
  failureCode         String?
  failureMessage      String?
  internalNote        String?
  attemptedAt         DateTime  @default(now())
  succeededAt         DateTime?
  failedAt            DateTime?
  refundedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([organizationId])
  @@index([chargeType])
  @@index([billingPeriod])
  @@index([status])
}

/// WGC-wide configuration for how the invoice feature is billed to
/// organizations. Starts DISABLED/DRAFT. Versioned the same way
/// WgcPricingVersion is — activating a new configuration never
/// retroactively bills InvoiceUsageEvent rows recorded before its
/// effectiveFrom date.
model InvoiceBillingConfiguration {
  id                               String    @id @default(cuid())
  // INCLUDED_IN_PLATFORM | MONTHLY_ADD_ON | PER_INVOICE_SENT |
  // PER_INVOICE_PAID | FLAT_MONTHLY_PLUS_USAGE | DISABLED
  mode                             String    @default("DISABLED")
  monthlyAmountCents               Int?
  usageAmountCents                 Int?
  // INVOICE_SENT | INVOICE_PAID
  trigger                          String?
  partialPaymentCountsAsBillable   Boolean   @default(false)
  multiplePaymentsCountOnce        Boolean   @default(true)
  minimumMonthlyChargeCents        Int?
  maximumMonthlyChargeCents        Int?
  freeUsageAllowance               Int?
  customerFacingDescription        String?
  showUsageAsEstimateBeforeBilling Boolean   @default(true)
  promotionWaivesInvoiceFees       Boolean   @default(false)
  effectiveFrom                    DateTime  @default(now())
  effectiveUntil                   DateTime?
  // DRAFT | ACTIVE | RETIRED
  status                           String    @default("DRAFT")
  createdByUserId                  String?
  activatedByUserId                String?
  activatedAt                      DateTime?
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt

  @@index([status])
}

/// Idempotent usage ledger for the invoice feature — recorded regardless of
/// whether invoice billing is currently active, so WGC can support future
/// pricing without losing historical usage data. Never used to bill
/// retroactively for activity that predates a pricing configuration's
/// effectiveFrom date.
model InvoiceUsageEvent {
  id                 String   @id @default(cuid())
  organizationId     String
  invoiceId          String
  invoicePaymentId   String?
  // INVOICE_CREATED | INVOICE_SENT | INVOICE_PAID | INVOICE_PARTIALLY_PAID |
  // INVOICE_VOIDED | INVOICE_REFUNDED | INVOICE_PAYMENT_REVERSED
  eventType          String
  occurredAt         DateTime @default(now())
  invoiceAmountCents Int?
  amountPaidCents    Int?
  currency           String   @default("USD")
  idempotencyKey     String   @unique
  billingPeriod      String?
  billable           Boolean  @default(false)
  nonBillableReason  String?
  pricingVersionId   String?
  billingChargeId    String?
  createdAt          DateTime @default(now())

  @@index([organizationId])
  @@index([invoiceId])
  @@index([billingPeriod])
  @@index([eventType])
}

/// Dedicated audit trail for WGC platform-billing/promotion actions. Kept
/// separate from DashboardAuditLog since many of these actions are WGC-admin
/// actions not tied to a single organization user, and financial-override
/// actions need explicit previous/new-value + reason tracking.
model WgcBillingAuditLog {
  id                   String   @id @default(cuid())
  organizationId       String?
  actorUserId          String?
  actorEmail           String?
  actorRole            String?
  // e.g. "promotion.lead_created", "subscription.created", "charge.refunded"
  action               String
  entityType           String?
  entityId             String?
  previousValue        Json?
  newValue             Json?
  internalReason       String?
  customerFacingReason String?
  idempotencyKey       String?
  ipAddress            String?
  userAgent            String?
  metadata             Json?
  createdAt            DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
}

/// Single-purpose, single-organization, hashed, expiring, revocable token
/// gating access to /activate-subscription/[token]. The raw token is emailed
/// once and never persisted — only its hash.
model BillingActivationToken {
  id             String    @id @default(cuid())
  organizationId String
  tokenHash      String    @unique
  expiresAt      DateTime
  consumedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId])
}

/// Period-scoped dedup for recurring/periodic billing emails (trial-ending
/// reminders, first-charge reminder, receipts, failed-payment notices,
/// cancellation confirmation) — distinct from EmailLog, which only dedups
/// "has this onboarding application ever received this email type" and has
/// no period concept.
model BillingEmailLog {
  id                    String    @id @default(cuid())
  organizationId        String
  recipientEmail        String
  // e.g. "TRIAL_ENDING_14_DAYS", "FIRST_CHARGE_RECEIPT"
  emailType             String
  // Composite dedup key, e.g. "{organizationId}:{emailType}:{periodOrChargeId}"
  idempotencyKey        String    @unique
  relatedSubscriptionId String?
  relatedChargeId       String?
  status                String    @default("PENDING")
  providerMessageId     String?
  failureReason         String?
  resendCount           Int       @default(0)
  sentAt                DateTime?
  createdAt             DateTime  @default(now())

  @@index([organizationId, emailType])
}

/// Church-scoped log of every donor/organization-facing email WGC sends on
/// an organization's behalf (donation receipts, external-donation receipts,
/// recurring-signup confirmations, annual statements, invoices, merchandise
/// order confirmations, subscription setup links). Written automatically by
/// sendWgcEmail() whenever its optional `log` block is supplied — internal/
/// admin-only emails (sendWgcAdminEmail, onboarding notices, etc.) never
/// pass that block and are therefore never written here, which is the
/// entire mechanism keeping this table donor-facing-only with no filtering
/// logic required elsewhere. A row is written on both the success and
/// failure path of a send, so a failed send is still visible/auditable
/// per-organization. No idempotency/unique constraint (unlike
/// BillingEmailLog) — donor emails are legitimately resent by design,
/// so uniqueness would fight the resend flow; resendCount plays that role
/// instead (0 or 1 per row — this is an append-only log, not an
/// update-in-place record, so it marks whether THIS row is itself a
/// resend, not a running total across resends of the same logical email).
model OrgEmailLog {
  id       String @id @default(cuid())
  churchId String

  // Plain string FK, no @relation — matches this codebase's established
  // convention for cross-references. Null for recipients that aren't a
  // Donor row (e.g. an Invoice's Client, a SubscriptionSetupLink not yet
  // matched to a donor).
  donorId        String?
  recipientEmail String
  recipientName  String?

  // DONATION_RECEIPT | EXTERNAL_DONATION_RECEIPT | RECURRING_CONFIRMATION |
  // ANNUAL_STATEMENT | INVOICE | MERCHANDISE_ORDER |
  // SUBSCRIPTION_SETUP_LINK | OTHER
  category String

  // Lets the resend dispatcher (POST /api/merchant/email-logs/[id]/resend)
  // look up and re-trigger the correct original sender — e.g.
  // relatedEntityType="Payment", relatedEntityId=payment.id for
  // DONATION_RECEIPT.
  relatedEntityType String?
  relatedEntityId   String?

  subject           String
  status            String    @default("SENT") // SENT | FAILED
  providerMessageId String?
  failureReason     String?
  resendCount       Int       @default(0)
  sentAt            DateTime?
  createdAt         DateTime  @default(now())

  // Null for a donor-triggered automatic send (e.g. a public giving-link
  // completion); set to the merchant user's id for a merchant-triggered
  // manual resend from this page.
  createdByUserId String?

  @@index([churchId, createdAt])
  @@index([churchId, donorId])
  @@index([churchId, category])
}

/// Versioned legal text for subscription terms / cancellation policy /
/// billing authorization / promotion terms / invoice billing terms. An
/// accepted WgcBillingAccount.authorizationTermsVersion always points at one
/// of these permanently, even after a newer version is published — existing
/// accepted authorizations are never rewritten.
model BillingTermsVersion {
  id                String   @id @default(cuid())
  // SUBSCRIPTION_TERMS | CANCELLATION_POLICY | BILLING_AUTHORIZATION |
  // PROMOTION_TERMS | INVOICE_BILLING_TERMS
  termsType         String
  version           String
  bodyMarkdown      String
  publishedAt       DateTime @default(now())
  publishedByUserId String?

  @@unique([termsType, version])
  @@index([termsType])
}

/// Singleton WGC-wide billing configuration (always exactly one row, id
/// "singleton") — grace period length, past-due reminder cadence, and which
/// dashboard features are restricted while an org's access gate is closed.
/// Editing this changes behavior going forward only; it is never applied
/// retroactively to already-computed gracePeriodEndsAt values on existing
/// WgcSubscription rows.
model WgcBillingSettings {
  id                       String   @id @default("singleton")
  gracePeriodDays          Int      @default(14)
  pastDueReminderDays      Int[]    @default([1, 3, 7, 12])
  trialEndingReminderDays  Int[]    @default([14, 3, 1])
  restrictedFeatureKeys    String[] @default([])
  supportContactEmail      String?
  updatedByUserId          String?
  updatedAt                DateTime @updatedAt
  createdAt                DateTime @default(now())
}

// =========================================================================
// Finix data sync layer (additive only — see /docs or PR description for plan)
// TODO: Confirm exact Finix termination/suspension API and webhook event with Finix.
// =========================================================================

model FinixMerchantSnapshot {
  id                 String    @id @default(cuid())
  churchId           String?
  finixIdentityId    String?
  finixMerchantId    String    @unique
  finixApplicationId String?
  finixProcessor     String?
  onboardingState    String?
  merchantState      String?
  processingEnabled  Boolean   @default(false)
  settlementEnabled  Boolean   @default(false)
  verificationState  String?
  riskState          String?
  payoutProfileId    String?
  merchantProfileId  String?
  feeProfileId       String?
  terminationStatus  String?
  terminatedAt       DateTime?
  terminationReason  String?
  suspendedAt        DateTime?
  suspensionReason   String?
  rawStateRedacted   Json?
  lastSyncedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model FinixTransfer {
  id                       String    @id @default(cuid())
  churchId                 String?
  paymentId                String?
  finixTransferId          String    @unique
  finixMerchantId          String?
  finixBuyerIdentityId     String?
  finixPaymentInstrumentId String?
  finixSettlementId        String?
  type                     String?
  subtype                  String?
  state                    String?
  amountCents              Int?
  currency                 String?
  feeCents                 Int?
  applicationFeeCents      Int?
  failureCode              String?
  failureMessage           String?
  traceId                  String?
  statementDescriptor      String?
  source                   String? // "wgc_giving_page" | "finix_dashboard" | "unknown"
  // Finix's own reported origin — confirmed real values include "SUBSCRIPTION",
  // "PAYMENT_LINK", "VIRTUAL_TERMINAL", "UNKNOWN". This is the authoritative
  // signal for "was this transfer a recurring-donation billing charge,"
  // rather than inferring it from whether the payment instrument merely has
  // a subscription attached (which a one-time gift on the same card would
  // also match).
  createdVia               String?
  // Exact payment-to-subscription attribution: the raw Finix transfer
  // payload's own `subscription` reference (not inferred from donor/amount/
  // instrument matching). Populated going forward by the TRANSFER webhook
  // handler, and backfillable from already-stored rawJsonRedacted for
  // historical rows with zero new Finix API calls. A transfer with
  // createdVia === "SUBSCRIPTION" but a null finixSubscriptionId has no
  // verified relationship and must be labeled "Unattributed Recurring
  // Candidate" rather than counted in confirmed recurring totals.
  finixSubscriptionId      String?
  tagsJson                 Json?
  rawJsonRedacted          Json?
  createdAtFinix           DateTime?
  updatedAtFinix           DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  lastSyncedAt             DateTime?
  // Set by the payment-reconciliation fallback (see paymentReconciliation.ts)
  // whenever it re-fetches this transfer from Finix directly — distinct from
  // lastSyncedAt, which is also touched by ordinary webhook processing.
  lastReconciledAt         DateTime?

  @@index([churchId, finixSubscriptionId])
  @@index([churchId, createdAtFinix])
}

model FinixRefundOrReversal {
  id                      String    @id @default(cuid())
  churchId                String?
  refundRequestId         String?
  originalPaymentId       String?
  finixReversalId         String    @unique
  finixOriginalTransferId String?
  finixMerchantId         String?
  finixSettlementId       String?
  amountCents             Int?
  currency                String?
  state                   String?
  reason                  String?
  failureCode             String?
  failureMessage          String?
  type                    String?
  subtype                 String?
  source                  String?
  traceId                 String?
  tagsJson                Json?
  rawJsonRedacted         Json?
  createdAtFinix          DateTime?
  updatedAtFinix          DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  lastSyncedAt            DateTime?

  @@index([churchId, createdAtFinix])
}

// A real ACH return (NACHA reason code), distinct from FinixRefundOrReversal
// (merchant-initiated refunds). Finix represents a return as a Transfer of
// subtype containing "RETURN" linked back to the original debit — this table
// gives it a first-class identity instead of relying on that heuristic at
// every read site.
model BankReturn {
  id                       String    @id @default(cuid())
  bankReturnId             String    @unique
  originalTransferId       String?
  churchId                 String?
  finixMerchantId          String?
  buyerId                  String?
  finixPaymentInstrumentId String?
  amountCents              Int?
  currency                 String?
  reasonCode               String?
  reasonDescription        String?
  state                    String?
  traceId                  String?
  effectiveAt              DateTime?
  rawPayloadRedacted       Json?
  createdAtFinix           DateTime?
  updatedAtFinix           DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  lastSyncedAt             DateTime?
}

model FinixFee {
  id              String    @id @default(cuid())
  churchId        String?
  finixFeeId      String?   @unique
  linkedToId      String?
  linkedToType    String?
  feeType         String?
  // Float, not Int: confirmed against a real Finix fee response that
  // basis-point-derived fees (e.g. CARD_BASIS_POINTS) come back with
  // fractional cents (e.g. 62.544) — an Int column silently rejected
  // these writes, which is why fee sync was failing for every payment.
  amountCents     Float?
  currency        String?
  state           String?
  description     String?
  rawJsonRedacted Json?
  createdAtFinix  DateTime?
  updatedAtFinix  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model FinixSettlement {
  id                         String    @id @default(cuid())
  churchId                   String?
  finixSettlementId          String    @unique
  finixMerchantId            String?
  state                      String? // legacy: historically the raw "status" value — left as-is for backward compat
  processorState             String? // raw processor state as returned by every sync, never overwritten by a mapped value
  totalAmountCents           Int? // gross amount
  netAmountCents             Int? // processor-reported net
  feeAmountCents             Int?
  refundAmountCents          Int?
  returnAmountCents          Int? // bank returns against payments in this settlement
  disputeAmountCents         Int?
  otherAdjustmentAmountCents Int?
  transactionCount           Int?
  feeCount                   Int?
  refundCount                Int?
  bankReturnCount            Int?
  disputeCount               Int?
  traceId                    String?
  currency                   String?
  accruedAt                  DateTime?
  settledAt                  DateTime?
  createdAtFinix             DateTime?
  updatedAtFinix             DateTime?
  rawJsonRedacted            Json?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  lastSyncedAt               DateTime?

  // Admin-controlled reconciliation state — never auto-set. The "calculated
  // net" vs "processor net" comparison itself is computed fresh on every
  // read from the settlement's actual included records, not stored here
  // (so it can't drift out of sync with the real numbers); this only
  // persists the human decision once a wgc_admin acts on it.
  reconciliationStatus String    @default("UNRECONCILED")
  reconciledAt         DateTime?
  reconciledByUserId   String?
  reconciledByEmail    String?
  reconciliationNotes  String?

  @@index([churchId])
  @@index([churchId, createdAtFinix])
}

model FinixFundingTransferAttempt {
  id                             String    @id @default(cuid())
  churchId                       String?
  finixFundingTransferAttemptId  String    @unique
  finixSettlementId              String?
  finixMerchantId                String?
  state                          String?
  amountCents                    Int?
  netAmountCents                 Int?
  currency                       String?
  fundingSpeed                   String? // NEXT_DAY | SAME_DAY | STANDARD | EXPRESS
  settlementCount                Int?
  paymentCount                   Int?
  bankAccountLast4               String?
  bankAccountType                String?
  bankName                       String?
  accountHolderName              String?
  // The payment-instrument ID funds were sent to — used to match this
  // deposit back to the merchant's own OrganizationBankAccount row (via
  // OrganizationBankAccount.finixPaymentInstrumentId) so the settlement
  // detail view can safely display bank name/account type/masked number
  // without re-deriving them from this table's own (sparser) fields.
  destinationPaymentInstrumentId String?
  failureCode                    String?
  failureMessage                 String?
  traceId                        String?
  estimatedArrivalDate           DateTime?
  sentAt                         DateTime?
  arrivedAt                      DateTime?
  rawJsonRedacted                Json?
  createdAtFinix                 DateTime?
  updatedAtFinix                 DateTime?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt
  lastSyncedAt                   DateTime?
  // Failed-payout retry tracking (PUT /settlements/{id} recovery flow) —
  // never rewrites this row's own state; a retry creates a brand new
  // FinixFundingTransferAttempt row via the normal webhook sync.
  retriedAt                      DateTime?
  retriedByUserId                String?

  @@index([churchId])
  @@index([finixSettlementId])
  @@index([churchId, createdAtFinix])
}

model FinixDispute {
  id                    String            @id @default(cuid())
  churchId              String?
  finixDisputeId        String            @unique
  finixTransferId       String?
  paymentId             String?
  finixMerchantId       String?
  state                 String? // legacy: historically the mapped display value — left as-is for backward compat with existing readers/filters
  processorState        String? // raw processor state as returned by every sync, never overwritten by a mapped value
  reason                String?
  amountCents           Int?
  currency              String?
  evidenceDueAt         DateTime?
  respondedAt           DateTime?
  resolvedAt            DateTime?
  outcome               String?
  // Submission failure/retry tracking: keep uploaded evidence and let the
  // admin retry final submission without re-uploading if it fails.
  submissionError       String?
  submissionAttemptedAt DateTime?
  submissionRetryCount  Int               @default(0)
  internalNote          String?
  rawJsonRedacted       Json?
  createdAtFinix        DateTime?
  updatedAtFinix        DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  lastSyncedAt          DateTime?
  evidence              DisputeEvidence[]

  @@index([churchId])
  @@index([evidenceDueAt])
  @@index([churchId, createdAtFinix])
}

// Metadata-only record of a dispute-evidence upload — the actual file bytes
// live in the processor (POST /disputes/{id}/evidence), never stored here.
// Deletion is soft (deletedAt) so audit-log rows referencing an evidenceId
// stay valid — the file is still gone from the admin's perspective (hidden
// everywhere, excluded from counts/allowance) without losing audit history.
model DisputeEvidence {
  id              String       @id @default(cuid())
  disputeId       String
  dispute         FinixDispute @relation(fields: [disputeId], references: [id])
  churchId        String?
  uploadedByEmail String?
  fileName        String
  fileSize        Int
  mimeType        String
  finixFileId     String?
  submittedAt     DateTime?
  deletedAt       DateTime?
  deletedByEmail  String?
  createdAt       DateTime     @default(now())

  @@index([disputeId])
  @@index([churchId])
}

// General-purpose dashboard action audit trail (distinct from the existing
// AuditLog, which is onboarding-flow-only). actorRole is a free string
// snapshotting whatever role the actor held at the time, not an FK — so
// this doesn't require adopting a wider role model to use.
model DashboardAuditLog {
  id          String   @id @default(cuid())
  churchId    String
  actorUserId String?
  actorEmail  String?
  actorRole   String?
  action      String
  entityType  String?
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([churchId, createdAt])
  @@index([entityType, entityId])
}

// "View as Merchant" admin impersonation session lifecycle (start/end/
// expiry) — the DB-backed source of truth every read of the signed
// wgc_impersonation cookie re-verifies against, so a revoked/expired/ended
// session (or a target org disabled mid-session) fails closed on the very
// next request rather than only at cookie-expiry time. Per-action writes
// made while impersonating are logged into the existing DashboardAuditLog
// (metadata carries actorType/actorAdminId/impersonationSessionId), not a
// second table here — this model is only the umbrella session record.
model AdminImpersonationSession {
  id               String    @id @default(cuid())
  adminUserId      String
  adminEmail       String
  targetChurchId   String
  targetChurchName String
  startedAt        DateTime  @default(now())
  expiresAt        DateTime
  endedAt          DateTime?
  endedReason      String?
  ipAddress        String?
  userAgent        String?

  @@index([adminUserId, endedAt])
  @@index([targetChurchId, startedAt])
}

model FinixPaymentInstrumentSnapshot {
  id                       String    @id @default(cuid())
  churchId                 String?
  donorId                  String?
  finixPaymentInstrumentId String    @unique
  finixIdentityId          String?
  instrumentType           String?
  paymentMethodType        String?
  cardBrand                String?
  // DEBIT | CREDIT | PREPAID | UNKNOWN — Finix's own `card_type` field.
  // Confirmed present on every real captured payment-instrument payload
  // (was previously never mapped from the raw JSON we already store).
  cardType                 String?
  cardLast4                String?
  cardExpirationMonth      Int?
  cardExpirationYear       Int?
  bankLast4                String?
  bankAccountType          String?
  accountHolderName        String?
  state                    String?
  enabled                  Boolean?
  disabledCode             String?
  disabledMessage          String?
  securityCodeVerification String?
  addressVerification      String?
  issuerCountry            String?
  addressCountry           String?
  instrumentUse            String?
  rawJsonRedacted          Json?
  createdAtFinix           DateTime?
  updatedAtFinix           DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  lastSyncedAt             DateTime?
}

model FinixSubscription {
  id                         String    @id @default(cuid())
  churchId                   String?
  churchSubscriptionId       String?
  givingLinkId               String?
  fundId                     String?
  // Snapshotted once at subscription-creation time from the donor's
  // selected Fund.name — never re-read later, so renaming a fund doesn't
  // change historical recurring-donation records. Same rationale as
  // Payment.fundName.
  fundName                   String?
  // Denormalized from FinixPaymentInstrumentSnapshot.donorId at webhook-sync
  // time — donor is only ever real-linked through the instrument, this
  // column exists purely so the Recurring Donors / Subscriptions list
  // queries can filter/sort/join by donor without an N+1 lookup per row.
  donorId                    String?
  finixSubscriptionId        String    @unique
  finixMerchantId            String?
  finixBuyerIdentityId       String?
  finixPaymentInstrumentId   String?
  // Raw processor state as reported by Finix (e.g. "ACTIVE", "CANCELED").
  // Display status (including MIXED/PAST_DUE/attention derivations across
  // a donor's multiple subscriptions) is always computed on read from this
  // plus related payment/instrument state — never stored redundantly.
  state                      String?
  amountCents                Int?
  currency                   String?
  billingInterval            String?
  collectionMethod           String?
  nextBillingDate            DateTime?
  startedAt                  DateTime?
  canceledAt                 DateTime?
  // Finix's subscriptions API (confirmed in src/lib/finix/client.ts) only
  // supports create/get/cancel — no pause/resume/update-in-place endpoint.
  // completedAt is set when Finix reports a finite subscription reaching
  // its natural end (not an admin action); cancelReason/canceledByUserId
  // distinguish a real admin-initiated cancellation from that.
  completedAt                DateTime?
  cancelReason               String?
  canceledByUserId           String?
  failureCode                String?
  failureMessage             String?
  retryCount                 Int?
  // "Update Amount"/"Update Frequency" have no in-place Finix endpoint, so
  // they're implemented as cancel-old + create-new. These two columns chain
  // that history so the UI can show "this subscription replaced/was
  // replaced by" instead of presenting two unrelated rows.
  supersedesSubscriptionId   String?
  supersededBySubscriptionId String?
  // Distinguishes an admin-created subscription (existing saved payment
  // method flow) from one created by a donor via the public giving page or
  // a secure setup link — never inferred, always set at creation time.
  createdByUserId            String?
  // Team-access Checkpoint 3: snapshotted once at subscription-creation time
  // from GivingLink.ownerUserId (via givingLinkId above) — never re-read
  // from the giving link afterward, so a later link reassignment doesn't
  // change history. Every recurring Payment generated from this subscription
  // inherits this value directly rather than re-deriving it. Null when
  // attribution can't be proven (no giving link, unowned link). Same
  // plain-string-FK rationale as Payment.attributedUserId.
  attributedUserId           String?
  consentSource              String? // ADMIN_CONFIRMED | DONOR_DIRECT
  rawJsonRedacted            Json?
  createdAtFinix             DateTime?
  updatedAtFinix             DateTime?
  donationAmountCents        Int?
  donorCoversFee             Boolean?
  feeCalculationVersion      String?

  // Reconciliation/date-sync fields — see subscriptionReconciliation.ts.
  // lastBillingAt/lastSuccessfulChargeAt are set from an actually-observed
  // recurring charge (webhook or reconciled transfer), never inferred by
  // adding one interval to the previous date. nextBillingDate is only ever
  // trusted from Finix's own schedule response, never computed locally.
  lastBillingAt          DateTime?
  lastSuccessfulChargeAt DateTime?
  lastReconciledAt       DateTime?
  // True when donorId could not be resolved (directly or via the linked
  // payment instrument) and needs an authorized admin to manually pick the
  // correct donor — never auto-matched by name alone.
  needsDonorMatching     Boolean   @default(false)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastSyncedAt DateTime?

  // Installment pledge fields — Finix's subscriptions API (see
  // src/lib/finix/client.ts) has no total-amount/installment-count/end-date
  // concept, so a "pledge with a total" is entirely WGC-side bookkeeping
  // layered on top of an otherwise-ordinary recurring subscription. When
  // isPledge is true, totalAmountCents is authoritative for the
  // completion-detection routine (subscriptionPledgeCompletion.ts, wired
  // into the existing reconciliation sweep); installmentsTotal/
  // installmentsCompleted are informational only and can diverge from the
  // dollar total if amountCents is ever changed mid-pledge via the existing
  // update-amount cancel/recreate flow. pledgeFulfilledAt is set once, the
  // moment the completion check auto-cancels the subscription.
  isPledge              Boolean   @default(false)
  totalAmountCents      Int?
  installmentsTotal     Int?
  installmentsCompleted Int?
  pledgeFulfilledAt     DateTime?

  @@index([churchId, donorId])
  @@index([churchId, state])
  @@index([churchId, attributedUserId])
  @@index([churchId, isPledge])
}

/// Immutable record of donor authorization for a recurring donation —
/// created exactly once at subscription-creation time and never mutated
/// afterward, even if the subscription itself is later changed/canceled.
model SubscriptionConsent {
  id                            String   @id @default(cuid())
  churchId                      String
  donorId                       String
  finixSubscriptionId           String   @unique
  consentSource                 String // ADMIN_CONFIRMED | DONOR_DIRECT
  confirmedByUserId             String?
  acceptedAt                    DateTime @default(now())
  termsVersion                  String
  ipAddress                     String?
  userAgent                     String?
  setupLinkId                   String?
  recurringTermsSnapshot        Json
  donorNameSnapshot             String?
  donorEmailSnapshot            String?
  amountCentsSnapshot           Int
  frequencySnapshot             String
  startDateSnapshot             DateTime
  paymentMethodLastFourSnapshot String?
  organizationNameSnapshot      String?
  createdAt                     DateTime @default(now())

  @@index([churchId, donorId])
}

/// Secure, single-purpose, expiring token a donor uses to set up a new
/// recurring donation without an admin ever touching raw payment data.
/// Only tokenHash is stored — the raw token exists only in the emailed URL.
model SubscriptionSetupLink {
  id                              String    @id @default(cuid())
  churchId                        String
  donorId                         String? // null until an existing donor is matched/a new one is created on completion
  donorFirstName                  String?
  donorLastName                   String?
  donorEmail                      String
  donorPhone                      String?
  tokenHash                       String    @unique
  amountCents                     Int
  billingInterval                 String
  startDate                       DateTime
  endDate                         DateTime?
  fundId                          String?
  message                         String?
  status                          String    @default("PENDING") // PENDING | SENT | OPENED | COMPLETED | EXPIRED | REVOKED | FAILED
  finixSubscriptionId             String? // set once the donor completes setup
  // When set, this link is a "Send Payment Update Link" for an existing
  // subscription rather than a brand-new one — completion cancels this
  // subscription and creates a replacement with the new payment method
  // (see FinixSubscription.supersedesSubscriptionId), same terms otherwise.
  updateTargetFinixSubscriptionId String?
  expiresAt                       DateTime
  sentAt                          DateTime?
  deliveredAt                     DateTime?
  openedAt                        DateTime?
  completedAt                     DateTime?
  revokedAt                       DateTime?
